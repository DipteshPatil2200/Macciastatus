{
  "name": "maccia-backend",
  "version": "1.0.0",
  "description": "MACCIA Backend API - Maharashtra Chamber of Commerce, Industry & Agriculture",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/seed.ts",
    "seed:temporary": "tsx src/seed/temporaryContent.ts",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "eslint . --ext .ts --quiet"
  },
  "author": "MACCIA",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.8",
    "helmet": "^8.0.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "eslint": "^9.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4"
  }
}
